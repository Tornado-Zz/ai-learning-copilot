# ---------------------------------------------------------------------------
# AI Learning Copilot - 本地 PostgreSQL 环境变量示例（复制为 infra/.env 后使用）
# 这里全部是本地开发的默认值：仅监听 127.0.0.1，只用于本机开发。
# 这套口令绝不可用于任何公开环境，也不可复用到测试/预发/生产。
# ---------------------------------------------------------------------------

# 宿主机端口，容器内固定为 5432；映射地址固定为 127.0.0.1
POSTGRES_PORT=5432

# 数据库用户名
POSTGRES_USER=copilot

# 数据库口令（本地开发默认口令，绝不可用于任何公开环境）
POSTGRES_PASSWORD=copilot_dev_password

# 数据库名
POSTGRES_DB=copilot

# ---------------------------------------------------------------------------
# 以下 Sprint 4 / Sprint 5 变量仅供参考：它们由后端进程读取，不属于 docker compose，
# 写在 infra/.env 里不会被任何容器使用。真正的生效位置是 apps/api/.env。
# ---------------------------------------------------------------------------
# AI_TIMEOUT_SECONDS=30            # 后端单次导师调用超时（秒）
# AI_DAILY_TOKEN_LIMIT=50000       # 后端每学习者每日 token 上限
# KNOWLEDGE_INGEST_ENABLED=false   # 后端知识库入库端点开关（默认关闭）
# KNOWLEDGE_STALE_DAYS=30          # 后端知识来源过期阈值（天）
# KNOWLEDGE_TOP_K=3                # 后端每次导师调用附带的引用条数（1–10）
# KNOWLEDGE_DOC_URLS=https://docs.python.org/3/tutorial/introduction.html,...  # 后端抓取白名单
