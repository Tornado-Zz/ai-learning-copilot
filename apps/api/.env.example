# ---------------------------------------------------------------------------
# AI Learning Copilot - 后端环境变量示例（复制为 apps/api/.env 后使用）
# 本文件只包含本地开发默认值或占位值，绝不写入任何真实密钥。
# ---------------------------------------------------------------------------

# 运行环境标识，会被 /api/v1/health 的 environment 字段原样返回
APP_ENV=local

# API 路由统一前缀
API_V1_PREFIX=/api/v1

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 数据库连接串（SQLAlchemy async 驱动 asyncpg），与 infra/docker-compose.yml 的默认值保持一致
DATABASE_URL=postgresql+asyncpg://copilot:copilot_dev_password@127.0.0.1:5432/copilot

# 允许跨域访问的前端来源，逗号分隔（不要带结尾斜杠）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DeepSeek API Key：留空时 ai_configured=false，非 AI 功能照常可用。绝对不要把真实 Key 提交到仓库。
DEEPSEEK_API_KEY=

# DeepSeek API 基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 常规任务使用的模型 id：需在 Sprint 2 对照 DeepSeek 官方文档确认
DEEPSEEK_MODEL=deepseek-flash

# 复杂任务使用的模型 id：需在 Sprint 2 对照 DeepSeek 官方文档确认
DEEPSEEK_MODEL_COMPLEX=deepseek-v4-pro
