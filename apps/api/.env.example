# ---------------------------------------------------------------------------
# AI Learning Copilot - 后端环境变量示例（复制为 apps/api/.env 后使用）
# 本文件只包含本地开发默认值或占位值，绝不写入任何真实密钥。
# 这里是后端变量的唯一权威清单；根目录 .env.example 第 1 段是同一份的摘要。
# ---------------------------------------------------------------------------

# 运行环境标识，会被 /api/v1/health 的 environment 字段原样返回
APP_ENV=local

# API 路由统一前缀
API_V1_PREFIX=/api/v1

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 数据库连接串（SQLAlchemy async 驱动 asyncpg），与 infra/docker-compose.yml 的默认值保持一致
DATABASE_URL=postgresql+asyncpg://copilot:copilot_dev_password@127.0.0.1:5432/copilot

# 允许跨域访问的前端来源，逗号分隔（不要带结尾斜杠）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Sprint 4：AI 导师
# ---------------------------------------------------------------------------

# DeepSeek API Key：留空时 ai_configured=false，/ai/* 端点返回 503 AI_UNAVAILABLE，
# 非 AI 功能照常可用。【绝不提交真实 Key】本文件进公开仓库，只能留空；
# 真实 Key 只写进 .gitignore 覆盖的 apps/api/.env。
DEEPSEEK_API_KEY=

# DeepSeek API 基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 常规任务使用的模型 id：启用真实调用前需对照 DeepSeek 官方文档确认
DEEPSEEK_MODEL=deepseek-flash

# 复杂任务使用的模型 id：启用真实调用前需对照 DeepSeek 官方文档确认
DEEPSEEK_MODEL_COMPLEX=deepseek-v4-pro

# 单次导师调用的上游超时（秒）：超过即中断并返回 504 AI_TIMEOUT，不自动重试
AI_TIMEOUT_SECONDS=30

# 每个学习者、每个 UTC 自然日可消耗的 token 上限（只算成功与失败的实际用量）；
# 超出时直接返回 429 AI_QUOTA_EXCEEDED，不发起任何上游请求
AI_DAILY_TOKEN_LIMIT=50000

# ---------------------------------------------------------------------------
# Sprint 5：知识库（关键词检索，无向量库依赖）
# ---------------------------------------------------------------------------

# 入库端点开关：入库是写路径，默认 false。
# false 时 POST /knowledge/ingest 返回 403 INGEST_DISABLED，且不做任何数据库或网络操作。
# 离线的 CLI 入库（uv run python -m app.cli.ingest）不受此开关限制。
KNOWLEDGE_INGEST_ENABLED=false

# 来源超过多少天未更新即标记 stale（源码内部下限为 1 天，写 0 不会把所有来源判为过期）
KNOWLEDGE_STALE_DAYS=30

# 单次导师调用最多附带几条知识库引用（源码内部限制在 1–10 之间）
KNOWLEDGE_TOP_K=3

# 允许入库的文档页白名单，逗号分隔。只接受 docs.python.org 的页面与 repo://lesson/<code>；
# 其他域名一律拒绝并返回 error_code=BLOCKED_HOST。不要擅自扩大这份白名单。
KNOWLEDGE_DOC_URLS=https://docs.python.org/3/tutorial/introduction.html,https://docs.python.org/3/tutorial/controlflow.html,https://docs.python.org/3/whatsnew/3.13.html
