# 复制为 .env.local 后使用（PowerShell：Copy-Item .env.example .env.local）
# NEXT_PUBLIC_ 前缀变量会内联进浏览器端代码，只能放公开地址，不要放任何密钥。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# 以下 Sprint 4 / Sprint 5 变量仅供参考，前端不读取、写在 .env.local 里不会生效。
# 它们的真正生效位置是 apps/api/.env（见该文件的 .env.example）。
# ---------------------------------------------------------------------------
# AI_TIMEOUT_SECONDS=30            # 后端单次导师调用超时
# AI_DAILY_TOKEN_LIMIT=50000       # 后端每学习者每日 token 上限
# KNOWLEDGE_INGEST_ENABLED=false   # 后端知识库入库端点开关（默认关闭）
# KNOWLEDGE_STALE_DAYS=30          # 后端知识来源过期阈值
# KNOWLEDGE_TOP_K=3                # 后端每次导师调用附带的引用条数
# KNOWLEDGE_DOC_URLS=https://docs.python.org/3/tutorial/introduction.html,...
