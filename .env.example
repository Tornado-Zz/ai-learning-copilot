# ---------------------------------------------------------------------------
# AI Learning Copilot - 根目录环境变量参考（三段：后端 / 前端 / 数据库）
# 用法：按段落把内容分别复制到对应位置，本文件本身不被任何程序加载。
# 全部为占位值或本地开发默认值，绝不包含真实密钥。
# 唯一权威的变量清单位于各服务自己的 .env.example，与其冲突时以其为准。
# ---------------------------------------------------------------------------

# ===========================================================================
# 第 1 段：后端 -> 复制到 apps/api/.env
# ===========================================================================
APP_ENV=local
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://copilot:copilot_dev_password@127.0.0.1:5432/copilot
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Sprint 4：AI 导师 ------------------------------------------------------
# 留空 = 未配置：/ai/* 端点返回 503 AI_UNAVAILABLE，其余功能照常可用。
# 【绝不提交真实 Key】本文件是公开仓库的一部分，只留空。真实 Key 只写进
# 已被 .gitignore 忽略的 apps/api/.env，用完也不要贴到 issue / PR / 截图里。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型 id：启用真实调用前需对照 DeepSeek 官方文档确认
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_COMPLEX=deepseek-v4-pro
# 单次导师调用的上游超时（秒），超时返回 504 AI_TIMEOUT，不重试
AI_TIMEOUT_SECONDS=30
# 每个学习者在 UTC 自然日内可消耗的 token 上限，超出返回 429 AI_QUOTA_EXCEEDED
AI_DAILY_TOKEN_LIMIT=50000

# --- Sprint 5：知识库 ------------------------------------------------------
# 入库端点是写路径，默认关闭：false 时 POST /knowledge/ingest 返回 403 INGEST_DISABLED
KNOWLEDGE_INGEST_ENABLED=false
# 超过多少天未更新就标记 stale（源码内部下限为 1，传 0 不会清空全部）
KNOWLEDGE_STALE_DAYS=30
# 单次导师调用最多带几条引用（源码内部上下限 1–10）
KNOWLEDGE_TOP_K=3
# 允许抓取的文档页白名单，逗号分隔。只接受 docs.python.org，不要擅自扩大范围。
KNOWLEDGE_DOC_URLS=https://docs.python.org/3/tutorial/introduction.html,https://docs.python.org/3/tutorial/controlflow.html,https://docs.python.org/3/whatsnew/3.13.html

# ===========================================================================
# 第 2 段：前端 -> 复制到 apps/web/.env.local（前端变量的权威清单由前端负责人维护）
# ===========================================================================
# 浏览器侧访问后端 API 的基地址（含版本前缀之外的 host:port）
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# 前端本地开发端口，需与后端 CORS_ORIGINS 一致
PORT=3000
# 注意：本段不读取第 1 段的任何变量。AI / 知识库配置只在 apps/api/.env 生效。

# ===========================================================================
# 第 3 段：数据库 -> 复制到 infra/.env
# ===========================================================================
# 本地开发默认口令，仅监听 127.0.0.1，绝不可用于任何公开环境
POSTGRES_PORT=5432
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev_password
POSTGRES_DB=copilot
